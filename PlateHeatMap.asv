%How many frames in animation 

frames = 80;

%Height of plate

height = 400;

%Width of plate

width = 400;

%Generate noise with time being frames long

noise = randn(height,width,frames);

%noise = noise/10;

%Generate x vector

x = 1:1:width;

%Generate y vector

y = transpose(1:1:height);

%Create particle matrix

particle = zeros(width,height,frames);

%Iterate through all frames

for frame = 1:1:frames

    %Make moving particle

    particle(frame,frame,frame) = frames-frame;

end

%Create surf object

map = surf(x,y,noise(:,:,1)); %[output:18366d37]

%Remove boundary colour

map.EdgeColor = "interp"; %[output:18366d37]


xlim([0 width]); %[output:18366d37]
ylim([0 height]); %[output:18366d37]
zlim([-20 frames]); %[output:18366d37]



colorbar %[output:18366d37]

%Update plot and draw it to screen to make animation

for frame = 1:1:size(noise,3) %[output:group:9652a0db]

    map.ZData = noise(:,:,frame) + particle(:,:,frame); %[output:18366d37]
    drawnow;

end %[output:group:9652a0db]

