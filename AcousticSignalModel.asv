clf; %[output:41fbd66a]
clear;

%Number of points to use for wave

N = 2100; %[control:slider:2c64]{"position":[5,9]}

%Define acoustic wave values

%Magnitude of energy stored in acoustic components

acousticWave.magnitude = linspace(1,1,N);

%The direction of the acoustic components in terms of x and y

directionVector = linspace(0,2*pi,N);

%circular placement of components 

%x = r*cos(theta)

acousticWave.xdirection = cos(directionVector);

%y = r*sin(theta)

acousticWave.ydirection = sin(directionVector);

%Store initial positions as the source of impulse (0,0 in this case)

X = 60; %[control:slider:272b]{"position":[5,7]}
Y = 60; %[control:slider:28f9]{"position":[5,7]}

acousticWave.xposition = linspace(X,X,N);
acousticWave.yposition = linspace(Y,Y,N);

%Boundary value (square for now and at +- value of this)

B = 255; %[control:slider:3837]{"position":[5,8]}

%Speed of the acoustic components

speed = 0.25;

%Make a set number of frames for the animation

  %[control:button:3bc8]{"position":[1,2]}

clf; %[output:41fbd66a]

plt = plot(acousticWave.xposition,acousticWave.yposition); %[output:41fbd66a]

%limit the plot to the boundaries

xlim([0,B]) %[output:41fbd66a]
ylim([0,B]) %[output:41fbd66a]

xlabel 'X Position' %[output:41fbd66a]
ylabel 'Y Position' %[output:41fbd66a]

for frame = linspace(0,40,800) %[output:group:04ae906e]

%Iterate through every point in the simulation

for point = 1:N

    

    %If a component reaches or crosses a boundary on the x, flip the x direction
    %take the absolute value to account for negative direction and 
    %round the value to prevent imprecision errors

    if (((acousticWave.xposition(point)) >= B) || (acousticWave.xposition(point) <= 0))

        acousticWave.xdirection(point) = -acousticWave.xdirection(point);
       
    end

    %Do same but for y

    if (((acousticWave.yposition(point)) >= B)  || (acousticWave.yposition(point) <= 0))
        
        acousticWave.ydirection(point) = -acousticWave.ydirection(point);

    end

    acousticWave.xposition(point) = acousticWave.xposition(point)+(acousticWave.xdirection(point)*speed);
    acousticWave.yposition(point) = acousticWave.yposition(point)+(acousticWave.ydirection(point)*speed);

end

    %Update plot data with new x positions

    plt.XData = acousticWave.xposition; %[output:41fbd66a]

    %Update plot data with new y positions

    plt.YData = acousticWave.yposition;

    drawnow

end %[output:group:04ae906e]

%%
%Section to calculate impulse response in presence of noise

  %[control:button:9ae4]{"position":[1,2]}

%Create a plate using the room object from acoustic sim toolbox
%Material may be changed to simulate a metal plate

plate = [B,B, 1];

%Position of the transmitter (same as proceeding section)

transmitter = [X,Y,0.5];

%Positions of receiver

Xr = 10; %[control:slider:3b94]{"position":[6,8]}
Yr = 30; %[control:slider:17bb]{"position":[6,8]}

%Receiver position object

receiver = [Xr,Yr,0.5];

%Impulse response from transmitter to receiver on the plate
%Input a material here to change the response

response = acousticRoomResponse(plate,transmitter,receiver);

fs = 10000;
t = (0:numel(response)-1)/fs;

%Plot noiseless impulse response 

impulse_response = plot(t,response); %[output:471b8ca5]

%Make a signal to send down channel

input_signal = cos(t);

input_signal(1000:end) = 0;

%Received signal from impulse response

received_signal = awgn(conv(response,input_signal),2,'measured');

%Make a time vector for the convolved signal

t2 = (0:numel(received_signal)-1)/fs;

%Make plot object for signal to allow for animation



%Downsample signal

downsample_factor = 50;

downsampled_signal = downsample(received_signal,downsample_factor);

t3 = downsample(t2,downsample_factor);

%Preallocate array for animation values

animation_y = zeros(1,length(downsampled_signal));

%Create plot object for the receiver signal animation

receiver_signal = plot(t3,animation_y); %[output:2f6a999a]

%Animation loop for the receiver signal

animation_x = t3;

for frame = (1:1:length(t3)) %[output:group:82ff9cde]

    %Insert sampled signal data into the animation vector

    animation_y(frame) = downsampled_signal(frame);

    %Set the new data for the plot

    receiver_signal.XData = animation_x; %[output:2f6a999a]
    receiver_signal.YData = animation_y;

    %Draw the new data on the plot

    drawnow
end %[output:group:82ff9cde]

%%
  %[control:button:13a0]{"position":[1,2]}

%Initialise energy vector

energy_y = zeros(1,length(downsampled_signal));

%Create energy plot object

energy_plot = plot(t3,animation_y); %[output:3623d257]

%Create animation for energy over time plot
animation_x = t3;

windowSize = 40;

energyThreshold = 2e-3;

%Create awgn signal

noisy_downsampled_signal = awgn(downsampled_signal,4,'measured');

for frame = (1:1:length(t3) - windowSize) %[output:group:7e74cf05]

    %Update y values with energy of signal in window
    
    energy_y(frame) = sum((noisy_downsampled_signal(frame:frame+windowSize)).^2);

    %Set the new data for the plot

    %energy_plot.XData = animation_x;
    energy_plot.YData = energy_y; %[output:3623d257]

    %If energy crosses a certain threshold then change the color of the plo
    %to red

    if energy_y(frame) > energyThreshold
        energy_plot.Color = 'r';
        
    else
        energy_plot.Color = 'g';
    end
    
    %Draw the new data on the plot

    drawnow
end %[output:group:7e74cf05]


