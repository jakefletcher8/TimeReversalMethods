%Define dimensions of a room

length = 10;
width = 10;
height = 2;

%Create room dimensions array

room = [length,width,height];

%Define receiver positions

rx = [1,6,1];

rx2 = [1,1,1];

%Define transmitter position

tx = [6,6,1];

%Impulse responses from transmitter to receiver

ir = acousticRoomResponse(room,tx,rx);

ir2 = acousticRoomResponse(room,rx,tx);

%Time vectors

t = linspace(0,0.2,size(ir,2));

t2 = linspace(0,0.2,size(ir2,2));

%Plot impulse response of the room for first position

subplot(2,1,1)

plot(t, ir);

%Labels

xlabel 'Time (s)'
ylabel 'Magnitude'

title 'Receiver - [1,6,1], Transmitter - [6,6,1]'

%Plot impulse response of the room for the second position

subplot(2,1,2)

plot(t2, ir2);

%Labels

xlabel 'Time (s)'
ylabel 'Magnitude'

title 'Receiver - [6,6,1], Transmitter - [1,6,1]'

%Create signal

y = [1,0,1,0,1,1,0];

%Send y signal down 

y_rec = conv(ir,y);